# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="mysql://root:password@localhost:3306/converge"

# MSG91 (OTP provider - https://msg91.com)
# Leave MSG91_AUTH_KEY empty to use sandbox mode (OTPs logged to console).
# SMS requires a DLT-approved template ID; email requires a verified domain.
MSG91_AUTH_KEY=""
MSG91_SMS_TEMPLATE_ID=""
MSG91_EMAIL_TEMPLATE_ID=""
MSG91_EMAIL_FROM=""
MSG91_EMAIL_DOMAIN=""
# Admin login code channel: "sms" (default) or "email". Staging uses "email".
ADMIN_LOGIN_OTP_CHANNEL=""

# Transactional (non-OTP) email templates — MSG91 is the email provider for these
# too. Optional: without a template ID the email degrades to a minimal log.
MSG91_ADMIN_NOTIFY_TEMPLATE_ID=""   # vars: application_id, name, email, phone, role, company
MSG91_MOREINFO_TEMPLATE_ID=""       # vars: items, other, message

# Where admin signup notifications are sent
ADMIN_EMAIL=""

# JWT signing secret for admin sessions. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64"))'
AUTH_SECRET=""

# Encrypts university-portal credentials at rest (generate: openssl rand -base64 32).
# Falls back to AUTH_SECRET when unset.
CREDENTIAL_ENCRYPTION_KEY=""

# DigitalOcean Spaces (S3-compatible object storage) for file uploads.
# Leave empty for local development — uploads then write to ./public/uploads.
# In production (DO App Platform has an EPHEMERAL filesystem) all five are required.
SPACES_KEY=""
SPACES_SECRET=""
SPACES_BUCKET=""
SPACES_REGION=""            # e.g. blr1
SPACES_ENDPOINT=""          # e.g. https://blr1.digitaloceanspaces.com
# Optional CDN base for public objects (logos). Defaults to the bucket origin.
SPACES_CDN_URL=""           # e.g. https://<bucket>.blr1.cdn.digitaloceanspaces.com

# DigitalOcean Managed MySQL requires TLS. Prisma uses sslaccept/sslcert query
# params — NOT the "?ssl-mode=REQUIRED" that DO prints in its connection string.
# Recommended: append "?sslaccept=strict" to DATABASE_URL and paste the DO CA
# certificate (PEM) below — it's written to a temp file at boot and verified.
# Leave empty for local dev (no TLS) or to connect encrypted-but-unverified.
DATABASE_CA_CERT=""

# Periskope (WhatsApp) — application status updates to students + inbound
# webhook at /api/v1/webhooks/whatsapp. Read directly from process.env in
# src/server/periskope.ts (not via env.js), so all are optional: with
# PERISKOPE_API_KEY unset the feature degrades silently (periskopeConfigured()
# returns false and sends are skipped). Set on the live DO app.
PERISKOPE_API_KEY=""        # Bearer token for the REST API
PERISKOPE_WEBHOOK_KEY=""    # HMAC secret verifying inbound webhooks
PERISKOPE_PHONE=""          # connected sender number (x-phone header)
PERISKOPE_API_URL=""        # optional base-URL override
