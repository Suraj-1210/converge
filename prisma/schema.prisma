model student_work_experience {
  id                Int     @id @default(autoincrement())
  student_id        Int
  company           String  @db.VarChar(150)
  job_title         String? @db.VarChar(100)
  employment_type   String? @db.VarChar(20)
  industry          String? @db.VarChar(50)
  start_month       Int     @db.UnsignedTinyInt
  start_year        Int     @db.UnsignedSmallInt
  end_month         Int?    @db.UnsignedTinyInt
  end_year          Int?    @db.UnsignedSmallInt
  currently_working Int     @default(0) @db.TinyInt
  city              String? @db.VarChar(100)
  country           String? @db.VarChar(50)
  description       String? @db.VarChar(1000)
  student           student @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_work_experience_student")

  @@index([student_id], map: "fk_work_experience_student_idx")
}

// One row per test attempt; `test` is the mock's test key (GRE, GMAT,
// GMAT_Focus, SAT, ACT, IELTS, TOEFL, TOEFL2026, PTE, Duolingo) and
// `scores` holds that test's field map (e.g. {"verbal":165,"quant":168}).
model student_test_score {
  id         Int       @id @default(autoincrement())
  student_id Int
  test       String    @db.VarChar(20)
  attempt    Int       @db.UnsignedTinyInt
  scores     Json
  test_date  DateTime? @db.Date
  student    student   @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_test_score_student")

  @@unique([student_id, test, attempt], map: "uq_test_score_student_test_attempt")
}

// Uni Assist shortlists — courses an admin flagged for a student. Precursor
// to an application; replaces the old localStorage-only persistence.
model shortlist {
  id                  Int               @id @default(autoincrement())
  student_id          Int
  course_id           Int
  // Admin who shortlisted; kept for attribution, null if the account goes.
  collegepond_user_id Int?
  // Who proposed it (ShortlistSource: 0 Collegepond, 1 partner) and, for a
  // partner proposal, which partner user.
  added_by              Int               @default(0) @db.UnsignedTinyInt
  added_by_user_id      Int?
  // The other side's decision (ShortlistApproval: 0 pending, 1 approved,
  // 2 rejected). Apply is refused until approved.
  approval_status       Int               @default(0) @db.UnsignedTinyInt
  proposed_at           DateTime          @default(now()) @db.Timestamp(0)
  proposal_note         String?           @db.VarChar(500)
  decided_at            DateTime?         @db.Timestamp(0)
  decided_by_user_id    Int?
  decided_by_cp_user_id Int?
  reject_reason         String?           @db.VarChar(500)
  created_at          DateTime          @default(now()) @db.Timestamp(0)
  student             student           @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_shortlist_student")
  course              course            @relation(fields: [course_id], references: [id], onDelete: Cascade, map: "fk_shortlist_course")
  collegepond_user    collegepond_user? @relation("shortlist_cp_user", fields: [collegepond_user_id], references: [id], onDelete: SetNull, map: "fk_shortlist_cp_user")
  added_by_user       user?             @relation("shortlist_added_by", fields: [added_by_user_id], references: [id], onDelete: SetNull, map: "fk_shortlist_added_by_user")
  decided_by_user     user?             @relation("shortlist_decided_by", fields: [decided_by_user_id], references: [id], onDelete: SetNull, map: "fk_shortlist_decided_by_user")
  decided_by_cp_user  collegepond_user? @relation("shortlist_decided_by_cp", fields: [decided_by_cp_user_id], references: [id], onDelete: SetNull, map: "fk_shortlist_decided_by_cp_user")

  @@unique([student_id, course_id], map: "uq_shortlist_student_course")
  @@index([course_id], map: "fk_shortlist_course_idx")
  @@index([collegepond_user_id], map: "fk_shortlist_cp_user_idx")
  @@index([approval_status], map: "idx_shortlist_approval")
  @@index([added_by_user_id], map: "fk_shortlist_added_by_user_idx")
  @@index([decided_by_user_id], map: "fk_shortlist_decided_by_user_idx")
  @@index([decided_by_cp_user_id], map: "fk_shortlist_decided_by_cp_user_idx")
}

// Saved Uni Assist filter sets. Team-wide: every admin can see and load any
// template; only the creator (or a super admin) can delete it.
model uni_assist_template {
  id                  Int              @id @default(autoincrement())
  name                String           @db.VarChar(100)
  filters             Json
  collegepond_user_id Int
  created_at          DateTime         @default(now()) @db.Timestamp(0)
  collegepond_user    collegepond_user @relation(fields: [collegepond_user_id], references: [id], onDelete: Cascade, map: "fk_uni_assist_template_cp_user")

  @@index([collegepond_user_id], map: "fk_uni_assist_template_cp_user_idx")
}

// Email OTP store (phone OTPs are managed by MSG91 server-side). One row per
// email identifier; hashed code + attempt counter enforce the verify cap.
model otp_code {
  id         Int      @id @default(autoincrement())
  identifier String   @unique(map: "uq_otp_identifier") @db.VarChar(255)
  code_hash  String   @db.VarChar(64)
  expires_at DateTime @db.Timestamp(0)
  attempts   Int      @default(0) @db.UnsignedTinyInt
  created_at DateTime @default(now()) @db.Timestamp(0)
}

// Tracks applied forward-only delta files (scripts/db-apply.sh). Infra table —
// not used by the app; mirrored here only to keep schema.prisma == schema.sql.
model schema_migrations {
  version    String   @id @db.VarChar(255)
  applied_at DateTime @default(now()) @db.Timestamp(0)
}

// Live, editable exchange rates for INR estimate conversion. mid_rate = mid-market
// (INR per 1 unit), refreshed from a feed; effective rate (computed in app) =
// manual_rate ?? mid_rate * (1 - margin_pct/100). INR is the base (not stored).
model fx_rate {
  currency    String    @id @db.VarChar(3)
  mid_rate    Decimal   @db.Decimal(12, 4)
  margin_pct  Decimal   @default(0) @db.Decimal(6, 3)
  manual_rate Decimal?  @db.Decimal(12, 4)
  source      String?   @db.VarChar(50)
  fetched_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamp(0)
}

// ===========================================================================
// Finance / Commission module
// ===========================================================================
// One spine (the per-application `commission`) with an inbound leg (CP bills the
// vendor) and an outbound leg (partner bills CP). Status codes live in
// src/server/db/enums.ts. All money is Decimal; currency is ISO Char(3); FX is
// entered manually (the INR actually deposited is the source of truth).

// A commission source: a direct university contract (type DIRECT) or a
// third-party aggregator like KC/Kaplan or IDP (type THIRD_PARTY) from which CP
// takes a share.
model vendor {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar(150)
  type                Int                   @db.UnsignedTinyInt
  contact_name        String?               @db.VarChar(100)
  contact_email       String?               @db.VarChar(255)
  contact_phone       String?               @db.VarChar(45)
  address             String?               @db.VarChar(255)
  is_active           Int                   @default(1) @db.TinyInt
  created_at          DateTime              @default(now()) @db.Timestamp(0)
  updated_at          DateTime              @default(now()) @db.Timestamp(0)
  commission_contract commission_contract[]
  vendor_invoice      vendor_invoice[]
  commission          commission[]
}

// The deal between a university and a vendor. vendor_id NULL = a direct
// university contract. Exactly one is_default per university (app-enforced) — the
// one offered when a counsellor picks a vendor on an application.
model commission_contract {
  id                          Int                           @id @default(autoincrement())
  university_id               Int
  vendor_id                   Int?
  cp_share_pct                Decimal?                      @db.Decimal(5, 2)
  is_default                  Int                           @default(0) @db.TinyInt
  effective_date              DateTime?                     @db.Date
  notes                       String?                       @db.VarChar(500)
  created_at                  DateTime                      @default(now()) @db.Timestamp(0)
  updated_at                  DateTime                      @default(now()) @db.Timestamp(0)
  university                  university                    @relation(fields: [university_id], references: [id], onDelete: Cascade, map: "fk_commission_contract_university")
  vendor                      vendor?                       @relation(fields: [vendor_id], references: [id], onDelete: SetNull, map: "fk_commission_contract_vendor")
  commission_rate             commission_rate[]
  commission_bonus_tier       commission_bonus_tier[]
  commission_tranche_template commission_tranche_template[]
  application                 application[]

  @@unique([university_id, vendor_id], map: "uq_contract_university_vendor")
  @@index([university_id], map: "fk_commission_contract_university_idx")
  @@index([vendor_id], map: "fk_commission_contract_vendor_idx")
}

// A rate within a contract. course_id NULL = the university-wide default rate for
// that contract; a set course_id is a program-specific override.
model commission_rate {
  id              Int                 @id @default(autoincrement())
  contract_id     Int
  course_id       Int?
  level           Int?                @db.UnsignedTinyInt
  commission_type Int                 @default(0) @db.UnsignedTinyInt
  rate            Decimal             @db.Decimal(12, 2)
  currency        String?             @db.Char(3)
  created_at      DateTime            @default(now()) @db.Timestamp(0)
  updated_at      DateTime            @default(now()) @db.Timestamp(0)
  contract        commission_contract @relation(fields: [contract_id], references: [id], onDelete: Cascade, map: "fk_commission_rate_contract")
  course          course?             @relation(fields: [course_id], references: [id], onDelete: Cascade, map: "fk_commission_rate_course")

  @@unique([contract_id, course_id], map: "uq_rate_contract_course")
  @@index([contract_id], map: "fk_commission_rate_contract_idx")
  @@index([course_id], map: "fk_commission_rate_course_idx")
}

// Volume bonus tiers (direct contracts) — e.g. 5+ students → a bonus per student.
model commission_bonus_tier {
  id                 Int                 @id @default(autoincrement())
  contract_id        Int
  min_students       Int                 @db.UnsignedSmallInt
  max_students       Int?                @db.UnsignedSmallInt
  amount_per_student Decimal             @db.Decimal(12, 2)
  currency           String?             @db.Char(3)
  created_at         DateTime            @default(now()) @db.Timestamp(0)
  contract           commission_contract @relation(fields: [contract_id], references: [id], onDelete: Cascade, map: "fk_bonus_tier_contract")

  @@index([contract_id], map: "fk_bonus_tier_contract_idx")
}

// Payment-schedule template for a contract (direct), max 4 tranches — e.g.
// "Tranche 1 — On Enrollment" / "Tranche 2 — On Completion".
model commission_tranche_template {
  id          Int                 @id @default(autoincrement())
  contract_id Int
  seq         Int                 @db.UnsignedTinyInt
  name        String              @db.VarChar(100)
  amount      Decimal?            @db.Decimal(12, 2)
  pct         Decimal?            @db.Decimal(5, 2)
  timing      String?             @db.VarChar(150)
  created_at  DateTime            @default(now()) @db.Timestamp(0)
  contract    commission_contract @relation(fields: [contract_id], references: [id], onDelete: Cascade, map: "fk_tranche_template_contract")

  @@unique([contract_id, seq], map: "uq_tranche_template_contract_seq")
  @@index([contract_id], map: "fk_tranche_template_contract_idx")
}

// Per-application tranche instances (only for tranche-based deals). Each tracks
// its own TrancheStatus + received/disbursed dates. Populated when we build
// tranche payouts; the template above seeds these.
model commission_tranche {
  id            Int           @id @default(autoincrement())
  commission_id Int
  seq           Int           @db.UnsignedTinyInt
  name          String?       @db.VarChar(100)
  amount        Decimal?      @db.Decimal(12, 2)
  amount_inr    Decimal?      @db.Decimal(14, 2)
  status        Int           @default(0) @db.UnsignedTinyInt
  received_at   DateTime?     @db.Timestamp(0)
  disbursed_at  DateTime?     @db.Timestamp(0)
  created_at    DateTime      @default(now()) @db.Timestamp(0)
  updated_at    DateTime      @default(now()) @db.Timestamp(0)
  commission    commission    @relation(fields: [commission_id], references: [id], onDelete: Cascade, map: "fk_commission_tranche_commission")
  invoice_item  invoice_item?

  @@unique([commission_id, seq], map: "uq_commission_tranche_seq")
  @@index([commission_id], map: "fk_commission_tranche_commission_idx")
}

// INBOUND: CP's invoice TO a vendor/university. Bundles confirmed-attended
// students; each line carries tuition, the calculated commission, and the entered
// expected amount + variance reason. Payments arrive in foreign currency and are
// recorded in INR (vendor_payment). created_by_cp_user_id is a loose audit ref.
model vendor_invoice {
  id                    Int                   @id @default(autoincrement())
  invoice_number        String                @unique(map: "uq_vendor_invoice_number") @db.VarChar(40)
  vendor_id             Int?
  university_id         Int?
  currency              String                @db.Char(3)
  invoice_date          DateTime              @db.Date
  due_date              DateTime?             @db.Date
  status                Int                   @default(0) @db.UnsignedTinyInt
  total_expected_amount Decimal               @db.Decimal(14, 2)
  notes                 String?               @db.VarChar(1000)
  fy                    Int?                  @db.SmallInt
  created_by_cp_user_id Int?
  created_at            DateTime              @default(now()) @db.Timestamp(0)
  updated_at            DateTime              @default(now()) @db.Timestamp(0)
  vendor                vendor?               @relation(fields: [vendor_id], references: [id], onDelete: SetNull, map: "fk_vendor_invoice_vendor")
  university            university?           @relation(fields: [university_id], references: [id], onDelete: SetNull, map: "fk_vendor_invoice_university")
  vendor_invoice_item   vendor_invoice_item[]
  vendor_payment        vendor_payment[]

  @@index([vendor_id], map: "fk_vendor_invoice_vendor_idx")
  @@index([university_id], map: "fk_vendor_invoice_university_idx")
  @@index([status], map: "idx_vendor_invoice_status")
}

// One vendor-invoice line per commission. calculated_commission = tuition × rate
// (server-computed); expected_amount is entered; variance + reason explain any gap
// (the mandatory-tuition decision is what enables this).
model vendor_invoice_item {
  id                    Int            @id @default(autoincrement())
  vendor_invoice_id     Int
  commission_id         Int            @unique(map: "uq_vendor_invoice_item_commission")
  tuition_amount        Decimal        @db.Decimal(12, 2)
  calculated_commission Decimal        @db.Decimal(12, 2)
  expected_amount       Decimal        @db.Decimal(12, 2)
  variance              Decimal        @default(0) @db.Decimal(12, 2)
  variance_reason       Int            @default(0) @db.UnsignedTinyInt
  variance_note         String?        @db.VarChar(255)
  created_at            DateTime       @default(now()) @db.Timestamp(0)
  vendor_invoice        vendor_invoice @relation(fields: [vendor_invoice_id], references: [id], onDelete: Cascade, map: "fk_vendor_invoice_item_invoice")
  commission            commission     @relation(fields: [commission_id], references: [id], onDelete: Restrict, map: "fk_vendor_invoice_item_commission")

  @@index([vendor_invoice_id], map: "fk_vendor_invoice_item_invoice_idx")
}

// A foreign payment received against a vendor invoice. amount_inr is the actual
// rupees deposited (source of truth); exchange_rate + amount_foreign are recorded
// for reconciliation. Supports partial/tranche payments and aging.
model vendor_payment {
  id                    Int            @id @default(autoincrement())
  vendor_invoice_id     Int
  amount_inr            Decimal        @db.Decimal(14, 2)
  exchange_rate         Decimal        @db.Decimal(12, 4)
  amount_foreign        Decimal        @db.Decimal(14, 2)
  payment_date          DateTime       @db.Date
  payment_reference     String?        @db.VarChar(100)
  is_tranche            Int            @default(0) @db.TinyInt
  tranche_number        Int?           @db.UnsignedTinyInt
  total_tranches        Int?           @db.UnsignedTinyInt
  is_final              Int            @default(0) @db.TinyInt
  notes                 String?        @db.VarChar(255)
  fy                    Int?           @db.SmallInt
  created_by_cp_user_id Int?
  created_at            DateTime       @default(now()) @db.Timestamp(0)
  vendor_invoice        vendor_invoice @relation(fields: [vendor_invoice_id], references: [id], onDelete: Cascade, map: "fk_vendor_payment_invoice")

  @@index([vendor_invoice_id], map: "fk_vendor_payment_invoice_idx")
}

// OUTBOUND: a partner's payout bank account. Per the compliance brief the raw
// account number ideally lives at the payouts provider (we keep the token +
// last4); gstin_enc/pan_enc are AES-256-GCM (src/server/crypto.ts). DPDP Rule 6.
model partner_bank_account {
  id                       Int              @id @default(autoincrement())
  // Owner: the agency (org_id) or the independent counsellor (payee_user_id).
  // Exactly one (chk_bank_account_payee).
  org_id                   Int?
  payee_user_id            Int?
  // 0 Domestic (IFSC), 1 International (SWIFT).
  region                   Int              @default(0) @db.UnsignedTinyInt
  account_holder           String           @db.VarChar(150)
  account_number_enc       String?          @db.VarChar(1024)
  account_number_last4     String?          @db.Char(4)
  ifsc                     String?          @db.VarChar(15)
  swift                    String?          @db.VarChar(15)
  iban                     String?          @db.VarChar(34)
  bank_name                String?          @db.VarChar(150)
  branch                   String?          @db.VarChar(150)
  bank_country             String?          @db.Char(2)
  bank_address             String?          @db.VarChar(255)
  account_type             String?          @db.VarChar(30)
  gstin_enc                String?          @db.VarChar(512)
  pan_enc                  String?          @db.VarChar(512)
  // Cancelled cheque / bank letter; checked by finance before verification.
  proof_url                String?          @db.VarChar(500)
  proof_file_name          String?          @db.VarChar(255)
  // When the partner last saved the details (orders the verification queue).
  submitted_at             DateTime         @default(now()) @db.Timestamp(0)
  provider_fund_account_id String?          @db.VarChar(100)
  provider_contact_id      String?          @db.VarChar(100)
  is_verified              Int              @default(0) @db.TinyInt
  verified_at              DateTime?        @db.Timestamp(0)
  verified_by_cp_user_id   Int?
  verification_note        String?          @db.VarChar(500)
  // Finance rejected the details; cleared when the partner saves new ones.
  rejected_at              DateTime?        @db.Timestamp(0)
  rejected_by_cp_user_id   Int?
  rejection_reason         String?          @db.VarChar(500)
  created_at               DateTime         @default(now()) @db.Timestamp(0)
  updated_at               DateTime         @default(now()) @db.Timestamp(0)
  organization             organization?    @relation(fields: [org_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_bank_account_org")
  payee_user               user?            @relation("bank_account_payee", fields: [payee_user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_bank_account_payee_user")
  invoice                  invoice[]
  partner_payout           partner_payout[]

  @@index([org_id], map: "fk_partner_bank_account_org_idx")
  @@index([is_verified, rejected_at, submitted_at], map: "idx_partner_bank_account_queue")
  @@index([payee_user_id], map: "fk_partner_bank_account_payee_user_idx")
}

// The reconciliation/release record for a partner invoice (1:1). Ops approval →
// Finance 4-point verification → release. Side-states: on-hold, sent-back. The
// *_by_cp_user_id columns are loose audit refs (no FK).
model partner_payout {
  id                         Int                   @id @default(autoincrement())
  invoice_id                 Int                   @unique(map: "uq_partner_payout_invoice")
  bank_account_id            Int?
  amount_inr                 Decimal               @db.Decimal(14, 2)
  status                     Int                   @default(0) @db.UnsignedTinyInt
  ops_approved_by_cp_user_id Int?
  ops_approved_at            DateTime?             @db.Timestamp(0)
  verify_bank_confirmed      Int                   @default(0) @db.TinyInt
  verify_invoice_verified    Int                   @default(0) @db.TinyInt
  verify_commission_verified Int                   @default(0) @db.TinyInt
  verify_duplicate_check     Int                   @default(0) @db.TinyInt
  verified_by_cp_user_id     Int?
  verified_at                DateTime?             @db.Timestamp(0)
  method                     Int?                  @db.UnsignedTinyInt
  bank_name                  String?               @db.VarChar(150)
  account_number_last4       String?               @db.Char(4)
  ifsc                       String?               @db.VarChar(15)
  swift                      String?               @db.VarChar(15)
  reference_number           String?               @db.VarChar(100)
  provider_payout_id         String?               @db.VarChar(100)
  utr                        String?               @db.VarChar(50)
  provider_status            String?               @db.VarChar(30)
  payment_date               DateTime?             @db.Date
  notes                      String?               @db.VarChar(500)
  released_by_cp_user_id     Int?
  released_at                DateTime?             @db.Timestamp(0)
  hold_reason                String?               @db.VarChar(500)
  sent_back_reason           String?               @db.VarChar(500)
  fy                         Int?                  @db.SmallInt
  created_at                 DateTime              @default(now()) @db.Timestamp(0)
  updated_at                 DateTime              @default(now()) @db.Timestamp(0)
  invoice                    invoice               @relation(fields: [invoice_id], references: [id], onDelete: Cascade, map: "fk_partner_payout_invoice")
  bank_account               partner_bank_account? @relation(fields: [bank_account_id], references: [id], onDelete: SetNull, map: "fk_partner_payout_bank_account")

  @@index([bank_account_id], map: "fk_partner_payout_bank_account_idx")
  @@index([status], map: "idx_partner_payout_status")
}

// --- BDM CRM ---------------------------------------------------------------
// Tables come from prisma/sql/schema.sql (migration 20261002120000_bdm_crm).
// Enum codes are in src/server/db/enums.ts. Activities and tasks attach to a
// partner (organization) OR a prospect, never both and never neither. That is
// enforced by DB CHECK constraints, which Prisma cannot model, so violations
// surface as a database error on write rather than a type error.

// An agency being courted before it becomes a partner. Kept after onboarding
// (converted_org_id) so its history survives.
model bdm_prospect {
  id               Int                          @id @default(autoincrement())
  agency_name      String                       @db.VarChar(255)
  contact_name     String?                      @db.VarChar(255)
  email            String?                      @db.VarChar(255)
  phone            String?                      @db.VarChar(20)
  city             String?                      @db.VarChar(120)
  // ProspectSource: 0 Cold Call, 1 Inbound Inquiry, 2 Referral, 3 Event / Exhibition, 4 LinkedIn, 5 Other.
  source           Int                          @db.UnsignedTinyInt
  // ProspectStage: 0 Lead, 1 Contacted, 2 Meeting Done, 3 Proposal Sent, 4 Negotiation, 5 Onboarding, 6 Converted, 7 Lost.
  stage            Int                          @default(0) @db.UnsignedTinyInt
  // ProspectTemperature: 0 Cold, 1 Lukewarm, 2 Warm, 3 Hot, 4 Signing Up.
  temperature      Int?                         @db.UnsignedTinyInt
  // Drives "Days in Stage". Update it whenever stage changes.
  stage_changed_at DateTime                     @default(now()) @db.Timestamp(0)
  next_follow_up   DateTime?                    @db.Date
  notes            String?                      @db.VarChar(1000)
  bdm_id           Int
  converted_org_id Int?
  created_at       DateTime                     @default(now()) @db.Timestamp(0)
  updated_at       DateTime                     @default(now()) @updatedAt @db.Timestamp(0)
  bdm              collegepond_user             @relation(fields: [bdm_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bdm_prospect_bdm")
  converted_org    organization?                @relation(fields: [converted_org_id], references: [id], onUpdate: NoAction, map: "fk_bdm_prospect_org")
  activities       bdm_activity[]
  stage_history    bdm_prospect_stage_history[]
  tasks            bdm_task[]

  @@index([converted_org_id], map: "fk_bdm_prospect_org_idx")
  @@index([bdm_id, stage], map: "idx_bdm_prospect_bdm_stage")
}

// One row per stage change, with the note from the "Advance Stage" modal.
// from_stage is null for the row written when the prospect is created.
model bdm_prospect_stage_history {
  id              Int               @id @default(autoincrement())
  prospect_id     Int
  from_stage      Int?              @db.UnsignedTinyInt
  to_stage        Int               @db.UnsignedTinyInt
  note            String?           @db.VarChar(1000)
  changed_by      Int?
  changed_at      DateTime          @default(now()) @db.Timestamp(0)
  prospect        bdm_prospect      @relation(fields: [prospect_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_prospect_stage_history_prospect")
  changed_by_user collegepond_user? @relation(fields: [changed_by], references: [id], onUpdate: NoAction, map: "fk_prospect_stage_history_user")

  @@index([changed_by], map: "fk_prospect_stage_history_user_idx")
  @@index([prospect_id, changed_at], map: "idx_prospect_stage_history")
}

// The Activity Log: calls, emails, meetings and notes against a partner or a
// prospect.
model bdm_activity {
  id              Int              @id @default(autoincrement())
  // BdmActivityType: 0 Call, 1 Email, 2 Meeting, 3 Note.
  type            Int              @db.UnsignedTinyInt
  organization_id Int?
  prospect_id     Int?
  occurred_on     DateTime         @db.Date
  duration_mins   Int?             @db.UnsignedSmallInt
  summary         String           @db.VarChar(1000)
  follow_up_date  DateTime?        @db.Date
  bdm_id          Int
  created_at      DateTime         @default(now()) @db.Timestamp(0)
  bdm             collegepond_user @relation(fields: [bdm_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bdm_activity_bdm")
  organization    organization?    @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bdm_activity_org")
  prospect        bdm_prospect?    @relation(fields: [prospect_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bdm_activity_prospect")

  @@index([organization_id], map: "fk_bdm_activity_org_idx")
  @@index([prospect_id], map: "fk_bdm_activity_prospect_idx")
  @@index([bdm_id, occurred_on], map: "idx_bdm_activity_bdm_date")
}

// "My Tasks" = tasks whose assignee is the viewer. Open / Due Today / Overdue
// are derived from due_date and is_done, not stored. Rescheduling overwrites
// due_date.
model bdm_task {
  id              Int               @id @default(autoincrement())
  title           String            @db.VarChar(255)
  description     String?           @db.VarChar(1000)
  organization_id Int?
  prospect_id     Int?
  due_date        DateTime          @db.Date
  // BdmTaskPriority: 0 Low, 1 Normal, 2 Urgent.
  priority        Int               @default(1) @db.UnsignedTinyInt
  // BdmTaskCategory: 0 Follow-up, 1 Meeting / Call, 2 Proposal / Document, 3 Onboarding, 4 Review / Check-in, 5 Other.
  category        Int               @db.UnsignedTinyInt
  is_done         Int               @default(0) @db.TinyInt
  completed_at    DateTime?         @db.Timestamp(0)
  assigned_to     Int
  created_by      Int?
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  updated_at      DateTime          @default(now()) @updatedAt @db.Timestamp(0)
  assignee        collegepond_user  @relation("bdm_task_assignee", fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bdm_task_assignee")
  creator         collegepond_user? @relation("bdm_task_creator", fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_bdm_task_creator")
  organization    organization?     @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bdm_task_org")
  prospect        bdm_prospect?     @relation(fields: [prospect_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_bdm_task_prospect")

  @@index([created_by], map: "fk_bdm_task_creator_idx")
  @@index([organization_id], map: "fk_bdm_task_org_idx")
  @@index([prospect_id], map: "fk_bdm_task_prospect_idx")
  @@index([assigned_to, is_done, due_date], map: "idx_bdm_task_assignee_due")
}

// Location master list (GeoNames, CC BY 4.0) for the signup pickers. Ids are
// GeoNames ids. Partners store the picked names, not these ids.
model geo_country {
  iso2      String      @id @db.Char(2)
  name      String      @db.VarChar(100)
  geo_state geo_state[]
  geo_city  geo_city[]
}

model geo_state {
  id           Int         @id @db.UnsignedInt
  country_iso2 String      @db.Char(2)
  // GeoNames admin1 code, e.g. IN.16 -> "16".
  code         String      @db.VarChar(20)
  name         String      @db.VarChar(100)
  country      geo_country @relation(fields: [country_iso2], references: [iso2], onDelete: NoAction, onUpdate: NoAction, map: "fk_geo_state_country")
  geo_city     geo_city[]

  @@unique([country_iso2, code], map: "uq_geo_state_country_code")
  @@index([country_iso2, name], map: "idx_geo_state_country_name")
}

model geo_city {
  id           Int         @id @db.UnsignedInt
  country_iso2 String      @db.Char(2)
  // NULL when GeoNames has no first-level division for the place.
  state_id     Int?        @db.UnsignedInt
  name         String      @db.VarChar(100)
  population   Int         @default(0) @db.UnsignedInt
  country      geo_country @relation(fields: [country_iso2], references: [iso2], onDelete: NoAction, onUpdate: NoAction, map: "fk_geo_city_country")
  state        geo_state?  @relation(fields: [state_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_geo_city_state")

  @@index([state_id, name], map: "idx_geo_city_state_name")
  @@index([country_iso2, name], map: "idx_geo_city_country_name")
}

// Partner chat: one thread per student between the partner side and
// Collegepond (see migrations/20261017061915_partner_chat.sql). Participants
// aren't stored; they follow the student's assignment
// (src/server/partner-chat-access.ts). Sender/uploader ids are plain ids; the
// FKs live in schema.sql.
model partner_chat_thread {
  id                  Int                       @id @default(autoincrement())
  student_id          Int                       @unique(map: "uq_partner_chat_thread_student")
  last_message_id     Int?
  last_message_at     DateTime?                 @db.Timestamp(0)
  last_sender_side    String?                   @db.VarChar(10)
  last_preview        String?                   @db.VarChar(200)
  // TAT clock: the first partner message still waiting for a Collegepond reply.
  awaiting_since      DateTime?                 @db.Timestamp(0)
  awaiting_message_id Int?
  tat_warned_at       DateTime?                 @db.Timestamp(0)
  tat_breached_at     DateTime?                 @db.Timestamp(0)
  created_at          DateTime                  @default(now()) @db.Timestamp(0)
  updated_at          DateTime                  @default(now()) @updatedAt @db.Timestamp(0)
  student             student                   @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_partner_chat_thread_student")
  message             partner_chat_message[]
  attachment          partner_chat_attachment[]
  read                partner_chat_read[]

  @@index([last_message_at], map: "idx_partner_chat_thread_last")
  @@index([awaiting_since], map: "idx_partner_chat_thread_awaiting")
}

// kind: "user" | "system"; sender_side: "partner" | "staff" | "system".
// tat_* is set on the Collegepond reply that ended a wait.
model partner_chat_message {
  id                        Int                       @id @default(autoincrement())
  thread_id                 Int
  kind                      String                    @default("user") @db.VarChar(10)
  sender_side               String                    @db.VarChar(10)
  sender_user_id            Int?
  sender_cp_user_id         Int?
  impersonator_cp_user_id   Int?
  body                      String?                   @db.Text
  edited_at                 DateTime?                 @db.Timestamp(0)
  tat_started_at            DateTime?                 @db.Timestamp(0)
  tat_business_minutes      Int?
  tat_counsellor_cp_user_id Int?
  // A Collegepond user marked this partner message "No reply needed":
  // it no longer holds the thread's reply clock.
  no_reply_needed_at            DateTime? @db.Timestamp(0)
  no_reply_needed_by_cp_user_id Int?
  created_at                DateTime                  @default(now()) @db.Timestamp(0)
  thread                    partner_chat_thread       @relation(fields: [thread_id], references: [id], onDelete: Cascade, map: "fk_partner_chat_message_thread")
  attachment                partner_chat_attachment[]

  @@index([thread_id, id], map: "idx_partner_chat_message_thread")
  @@index([tat_started_at], map: "idx_partner_chat_message_tat")
  @@index([sender_user_id], map: "fk_partner_chat_message_user_idx")
  @@index([sender_cp_user_id], map: "fk_partner_chat_message_cp_user_idx")
}

// A file sent in chat. Uploaded first (message_id null), then attached by the
// send; saved_document_id once copied into the student's documents.
model partner_chat_attachment {
  id                     Int                   @id @default(autoincrement())
  thread_id              Int
  message_id             Int?
  uploaded_side          String                @db.VarChar(10)
  uploaded_by_user_id    Int?
  uploaded_by_cp_user_id Int?
  file_name              String                @db.VarChar(255)
  file_url               String                @db.VarChar(500)
  mime_type              String?               @db.VarChar(100)
  size_bytes             Int?
  saved_document_id      Int?
  saved_at               DateTime?             @db.Timestamp(0)
  created_at             DateTime              @default(now()) @db.Timestamp(0)
  thread                 partner_chat_thread   @relation(fields: [thread_id], references: [id], onDelete: Cascade, map: "fk_partner_chat_attachment_thread")
  message                partner_chat_message? @relation(fields: [message_id], references: [id], onDelete: Cascade, map: "fk_partner_chat_attachment_message")

  @@index([message_id], map: "idx_partner_chat_attachment_message")
  @@index([thread_id], map: "idx_partner_chat_attachment_thread")
  @@index([file_url], map: "idx_partner_chat_attachment_file")
  @@index([saved_document_id], map: "fk_partner_chat_attachment_document_idx")
}

// Read position per participant: side "partner" (reader_id = user.id) or
// "staff" (reader_id = cp_user.id). emailed_through_message_id: how far the
// unread-message email has covered.
model partner_chat_read {
  id                         Int                 @id @default(autoincrement())
  thread_id                  Int
  side                       String              @db.VarChar(10)
  reader_id                  Int
  last_read_message_id       Int                 @default(0)
  emailed_through_message_id Int                 @default(0)
  read_at                    DateTime?           @db.Timestamp(0)
  thread                     partner_chat_thread @relation(fields: [thread_id], references: [id], onDelete: Cascade, map: "fk_partner_chat_read_thread")

  @@unique([thread_id, side, reader_id], map: "uq_partner_chat_read")
}

// TAT master (Settings -> TAT Settings, Super Admin). One row (id 1):
// working days ("1,2,…" with ISO 1 = Monday) and hours in minutes from midnight.
model tat_setting {
  id                    Int      @id
  timezone              String   @default("Asia/Kolkata") @db.VarChar(64)
  work_days             String   @default("1,2,3,4,5,6") @db.VarChar(20)
  day_start_minute      Int      @default(600) @db.SmallInt
  day_end_minute        Int      @default(1140) @db.SmallInt
  // Partner chat acknowledgements that don't start the reply clock
  // (newline-separated; NULL = the built-in list, src/lib/partner-chat-rules.ts).
  chat_ack_phrases      String?  @db.VarChar(1000)
  chat_ack_max_length   Int      @default(40) @db.SmallInt
  updated_by_cp_user_id Int?
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

model tat_holiday {
  id           Int      @id @default(autoincrement())
  holiday_date DateTime @unique(map: "uq_tat_holiday_date") @db.Date
  name         String   @db.VarChar(100)
  created_at   DateTime @default(now()) @db.Timestamp(0)
}

// Per-action TAT target. "chat_response" = Collegepond replying in partner chat.
model tat_action_target {
  id                    Int      @id @default(autoincrement())
  action_key            String   @unique(map: "uq_tat_action_target_key") @db.VarChar(50)
  label                 String   @db.VarChar(100)
  threshold_minutes     Int
  warning_pct           Int      @default(80) @db.TinyInt
  active                Int      @default(1) @db.TinyInt
  updated_by_cp_user_id Int?
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamp(0)
}

// Out of office (24 Oct 2026). One row per counsellor; "out" is worked out
// from the dates (inclusive, TAT timezone), so it ends by itself. While out,
// the alternate covers their partner chats, chat reply TAT and new
// auto-assigned students. See src/server/out-of-office.ts.
model cp_out_of_office {
  id                   Int              @id @default(autoincrement())
  cp_user_id           Int              @unique(map: "uq_cp_out_of_office_user")
  from_date            DateTime         @db.Date
  to_date              DateTime         @db.Date
  alternate_cp_user_id Int
  set_by_cp_user_id    Int?
  created_at           DateTime         @default(now()) @db.Timestamp(0)
  updated_at           DateTime         @default(now()) @updatedAt @db.Timestamp(0)
  cp_user              collegepond_user @relation("cp_out_of_office_user", fields: [cp_user_id], references: [id], onDelete: Cascade, map: "fk_cp_out_of_office_user")
  alternate            collegepond_user @relation("cp_out_of_office_alternate", fields: [alternate_cp_user_id], references: [id], onDelete: Cascade, map: "fk_cp_out_of_office_alternate")

  @@index([alternate_cp_user_id], map: "fk_cp_out_of_office_alternate_idx")
  @@index([from_date, to_date], map: "idx_cp_out_of_office_dates")
}

// Persistent in-app feed for Collegepond staff (admin Notifications page and
// bell). The partner users' feed is `notification`.
model cp_notification {
  id         Int              @id @default(autoincrement())
  cp_user_id Int
  type       String           @db.VarChar(50)
  title      String           @db.VarChar(255)
  body       String?          @db.VarChar(500)
  link       String?          @db.VarChar(255)
  tone       String           @default("blue") @db.VarChar(10)
  read_at    DateTime?        @db.Timestamp(0)
  created_at DateTime         @default(now()) @db.Timestamp(0)
  cp_user    collegepond_user @relation(fields: [cp_user_id], references: [id], onDelete: Cascade, map: "fk_cp_notification_user")

  @@index([cp_user_id, created_at], map: "idx_cp_notification_user_created")
  @@index([cp_user_id, read_at], map: "idx_cp_notification_user_read")
}
