// Counselling teams (Settings -> Counselling Teams, Super Admin). One team per
// Counsellor Lead: the counsellors who report to them, the primary SPOC new
// leads route to, and the lead's Auto Assign switch. See src/server/staff-access.ts.
model counsellor_team {
  id                      Int                      @id @default(autoincrement())
  lead_cp_user_id         Int                      @unique(map: "uq_counsellor_team_lead")
  primary_spoc_cp_user_id Int?
  auto_assign             Int                      @default(0) @db.TinyInt
  created_at              DateTime                 @default(now()) @db.Timestamp(0)
  updated_at              DateTime                 @default(now()) @updatedAt @db.Timestamp(0)
  lead                    collegepond_user         @relation("counsellor_team_lead", fields: [lead_cp_user_id], references: [id], onDelete: Cascade, map: "fk_counsellor_team_lead")
  primary_spoc            collegepond_user?        @relation("counsellor_team_spoc", fields: [primary_spoc_cp_user_id], references: [id], onDelete: SetNull, map: "fk_counsellor_team_spoc")
  member                  counsellor_team_member[]

  @@index([primary_spoc_cp_user_id], map: "fk_counsellor_team_spoc_idx")
}

// A counsellor reporting to a lead; at most one team per counsellor.
model counsellor_team_member {
  id         Int              @id @default(autoincrement())
  team_id    Int
  cp_user_id Int              @unique(map: "uq_counsellor_team_member")
  created_at DateTime         @default(now()) @db.Timestamp(0)
  team       counsellor_team  @relation(fields: [team_id], references: [id], onDelete: Cascade, map: "fk_counsellor_team_member_team")
  cp_user    collegepond_user @relation(fields: [cp_user_id], references: [id], onDelete: Cascade, map: "fk_counsellor_team_member_user")

  @@index([team_id], map: "fk_counsellor_team_member_team_idx")
}

// Department master for internal staff (Settings -> Departments, Super Admin).
// Organisational only — permissions come from collegepond_user.role.
model department {
  id         Int                @id @default(autoincrement())
  name       String             @unique(map: "uq_department_name") @db.VarChar(100)
  is_active  Int                @default(1) @db.TinyInt
  sort_order Int                @default(0)
  created_at DateTime           @default(now()) @db.Timestamp(0)
  updated_at DateTime           @default(now()) @updatedAt @db.Timestamp(0)
  cp_user    collegepond_user[]
}

// Partner Tiers master (Settings -> Partner Tiers). Display data; edits apply
// immediately. The ranges and commission share live per FY in partner_tier_rule.
// See src/server/partner-tiers.ts and 20261014091941_partner_tiers.
model partner_tier {
  id            Int                     @id @default(autoincrement())
  name          String                  @unique(map: "uq_partner_tier_name") @db.VarChar(50)
  display_order Int                     @default(0)
  badge_color   String                  @default("#344054") @db.Char(7)
  icon          String?                 @db.VarChar(16)
  benefits      Json
  is_active     Int                     @default(1) @db.TinyInt
  created_at    DateTime                @default(now()) @db.Timestamp(0)
  updated_at    DateTime                @default(now()) @updatedAt @db.Timestamp(0)
  rules         partner_tier_rule[]
  overrides     partner_tier_override[]
  commissions   commission[]
}

// The tier ladder for one financial year (fy = start year). FY X uses the rows
// of the latest fy <= X; Super Admin edits are written for the next FY.
model partner_tier_rule {
  id                    Int               @id @default(autoincrement())
  fy                    Int               @db.SmallInt
  tier_id               Int
  min_students          Int               @db.UnsignedSmallInt
  max_students          Int?              @db.UnsignedSmallInt
  share_pct             Decimal           @db.Decimal(5, 2)
  created_by_cp_user_id Int?
  created_at            DateTime          @default(now()) @db.Timestamp(0)
  tier                  partner_tier      @relation(fields: [tier_id], references: [id], map: "fk_partner_tier_rule_tier")
  created_by            collegepond_user? @relation(fields: [created_by_cp_user_id], references: [id], onDelete: SetNull, map: "fk_partner_tier_rule_cp_user")

  @@unique([fy, tier_id], map: "uq_partner_tier_rule_fy_tier")
  @@index([tier_id], map: "fk_partner_tier_rule_tier_idx")
  @@index([created_by_cp_user_id], map: "fk_partner_tier_rule_cp_user_idx")
}

// A Super Admin floor on one partner's tier (agency owner or independent).
model partner_tier_override {
  id                Int               @id @default(autoincrement())
  user_id           Int               @unique(map: "uq_partner_tier_override_user")
  tier_id           Int
  ends_on           DateTime?         @db.Date
  reason            String?           @db.VarChar(255)
  is_migrated       Int               @default(0) @db.TinyInt
  set_by_cp_user_id Int?
  set_at            DateTime          @default(now()) @db.Timestamp(0)
  user              user              @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_partner_tier_override_user")
  tier              partner_tier      @relation(fields: [tier_id], references: [id], map: "fk_partner_tier_override_tier")
  set_by            collegepond_user? @relation(fields: [set_by_cp_user_id], references: [id], onDelete: SetNull, map: "fk_partner_tier_override_cp_user")

  @@index([tier_id], map: "fk_partner_tier_override_tier_idx")
  @@index([set_by_cp_user_id], map: "fk_partner_tier_override_cp_user_idx")
}

// Tasks & Notes tab — one row is either a note (is_task 0) or a task
// (is_task 1, with due date / priority / done). Converting between the two
// just flips is_task, mirroring the mock.
model student_note {
  id                  Int               @id @default(autoincrement())
  student_id          Int
  body                String            @db.VarChar(1000)
  is_task             Int               @default(0) @db.TinyInt
  due_date            DateTime?         @db.Date
  // 0 Low, 1 Medium, 2 High.
  priority            Int?              @db.UnsignedTinyInt
  is_done             Int               @default(0) @db.TinyInt
  created_at          DateTime          @default(now()) @db.Timestamp(0)
  updated_at          DateTime          @default(now()) @updatedAt @db.Timestamp(0)
  collegepond_user_id Int?
  student             student           @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_note_student")
  collegepond_user    collegepond_user? @relation(fields: [collegepond_user_id], references: [id], onDelete: SetNull, map: "fk_note_cp_user")

  @@index([student_id], map: "fk_note_student_idx")
  @@index([collegepond_user_id], map: "fk_note_cp_user_idx")
}

// 0 Parent, 1 Sibling, 2 Spouse, 3 Friend, 4 Other.
model student_emergency_contact {
  id           Int     @id @default(autoincrement())
  student_id   Int
  relationship Int     @db.UnsignedTinyInt
  name         String  @db.VarChar(100)
  email        String? @db.VarChar(255)
  phone        String? @db.VarChar(45)
  student      student @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_emergency_contact_student")

  @@index([student_id], map: "fk_emergency_contact_student_idx")
}

// One row per education level (EducationLevel enum) — the profile page's
// Academic Qualification sections.
model student_education {
  id              Int     @id @default(autoincrement())
  student_id      Int
  level           Int     @db.UnsignedTinyInt
  country         String? @db.VarChar(50)
  board           String? @db.VarChar(100)
  state           String? @db.VarChar(50)
  qualification   String? @db.VarChar(100)
  institution     String? @db.VarChar(150)
  city            String? @db.VarChar(100)
  grading_system  String? @db.VarChar(20)
  scale           String? @db.VarChar(50)
  score           String? @db.VarChar(20)
  language        String? @db.VarChar(30)
  pass_month      Int?    @db.UnsignedTinyInt
  pass_year       Int?    @db.UnsignedSmallInt
  major           String? @db.VarChar(100)
  research_topic  String? @db.VarChar(255)
  predicted_score String? @db.VarChar(20)
  student         student @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "fk_education_student")

