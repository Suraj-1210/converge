  approved_by_collegepond_user_id                                         Int?                      @map("approved_by_cp_user_id")
  lead_counsellor_id                                                      Int?
  counsellor_id                                                           Int?
  bdm_id                                                                  Int?
  notes                                                                   String?                   @db.VarChar(255)
  status_reason                                                           String?                   @db.VarChar(500)
  tier                                                                    Int                       @default(0) @db.UnsignedTinyInt
  mou_signed_at                                                           DateTime?                 @db.Timestamp(0)
  // MOU signature: drawn = PNG data URL, typed = the typed name.
  mou_signature                                                           String?                   @db.MediumText
  mou_signature_kind                                                      Int?                      @db.UnsignedTinyInt
  mou_signer_name                                                         String?                   @db.VarChar(101)
  mou_signed_ip                                                           String?                   @db.VarChar(45)
  mou_version                                                             String?                   @db.VarChar(20)
  mou_pdf_url                                                             String?                   @db.VarChar(500)
  last_login_at                                                           DateTime?                 @db.Timestamp(0)
  // Soft delete: counsellor removed by their agency (status is INACTIVE too).
